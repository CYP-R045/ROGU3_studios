---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getProducts, type ShopifyProduct } from "../../lib/shopify";

export async function getStaticPaths() {
  const products = await getProducts();
  return products.map((product) => ({
    params: { handle: product.handle },
    props: { product },
  }));
}

interface Props { product: ShopifyProduct; }
const { product } = Astro.props;
---

<BaseLayout title={product.title} theme="dark">
  <section class="wrap">
    <div class="media">
      <img
        id="mainImg"
        class="img"
        src={product.images?.[0]}
        alt={product.title}
      />

      {
        product.images && product.images.length > 1 && (
          <div class="thumbs" aria-label="Image thumbnails">
            {product.images.map((src, i) => (
              <button
                class="thumb"
                type="button"
                data-src={src}
                aria-label={`View image ${i + 1}`}
              >
                <img src={src} alt="" />
              </button>
            ))}
          </div>
        )
      }
    </div>

    <div class="info">
      <h1>{product.title}</h1>
      <div class="price">{product.price}</div>

      {
        product.variants.length > 1 && (
          <select id="variantSelect" class="variantSelect">
            {product.variants.map((v) => (
              <option value={v.id} disabled={!v.availableForSale}>
                {v.title} {!v.availableForSale ? "(Sold out)" : ""}
              </option>
            ))}
          </select>
        )
      }

      <button
        class="btn"
        id="addToCartBtn"
        data-default-variant-id={product.variants[0]?.id}
        disabled={!product.variants[0]?.availableForSale}
      >
        {product.variants[0]?.availableForSale ? "Add to cart" : "Sold out"}
      </button>
      <p id="addToCartStatus" class="status" role="status"></p>
    </div>
  </section>

  <script>
    import { addToCart } from "../../lib/cartClient";

    const mainImg = document.querySelector("#mainImg");
    const thumbs = document.querySelectorAll(".thumb");
    thumbs.forEach((btn) => {
      btn.addEventListener("click", () => {
        const src = btn.getAttribute("data-src");
        if (mainImg && src) mainImg.setAttribute("src", src);
      });
    });

    const addBtn = document.querySelector<HTMLButtonElement>("#addToCartBtn");
    const variantSelect = document.querySelector<HTMLSelectElement>("#variantSelect");
    const status = document.querySelector<HTMLParagraphElement>("#addToCartStatus");

    addBtn?.addEventListener("click", async () => {
      const variantId = variantSelect?.value || addBtn.dataset.defaultVariantId;
      if (!variantId) return;

      addBtn.disabled = true;
      const originalText = addBtn.textContent;
      addBtn.textContent = "Adding...";

      try {
        await addToCart(variantId, 1);
        if (status) status.textContent = "Added to cart.";
        addBtn.textContent = "Add another";
      } catch (err) {
        console.error(err);
        if (status) status.textContent = "Couldn't add to cart. Try again.";
        addBtn.textContent = originalText;
      } finally {
        addBtn.disabled = false;
      }
    });
  </script>

  <style>
    .wrap {
      padding: 48px 22px;
      max-width: 1000px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 24px;
    }
    .media {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }
    .img {
      width: 100%;
      max-height: 480px;
      border-radius: 18px;
      object-fit: cover;
      background: color-mix(in srgb, var(--text) 5%, transparent);
    }
    .thumbs {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
    }
    .thumb {
      border: 0;
      padding: 0;
      border-radius: 12px;
      overflow: hidden;
      width: 86px;
      height: 86px;
      cursor: pointer;
      background: transparent;
    }
    .thumb img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    h1 {
      margin: 0 0 10px;
      font-size: 36px;
    }
    .price {
      font-weight: 800;
      margin-bottom: 14px;
    }
    .desc {
      opacity: 0.85;
      line-height: 1.6;
    }
    .variantSelect {
      margin-top: 12px;
      display: block;
      padding: 10px 12px;
      border-radius: 12px;
      border: 1px solid color-mix(in srgb, var(--text) 20%, transparent);
      background: color-mix(in srgb, var(--text) 6%, transparent);
      color: var(--text);
      font-weight: 600;
    }
    .btn {
      margin-top: 18px;
      padding: 12px 16px;
      border-radius: 14px;
      border: 0;
      background: var(--text);
      color: var(--bg);
      cursor: pointer;
      font-weight: 700;
    }
    .btn:disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }
    .status {
      margin-top: 10px;
      font-size: 13px;
      opacity: 0.75;
      min-height: 1em;
    }
    @media (max-width: 900px) {
      .wrap {
        grid-template-columns: 1fr;
      }
    }
  </style>
</BaseLayout>
