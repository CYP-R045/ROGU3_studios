---
import "../styles/global.css";
import LoadingScreen from "../components/LoadingScreen";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>ROGU3</title>
    <script>
      if (localStorage.getItem("rogu3_unlocked") !== "1") {
        window.location.replace("/");
      }
    </script>
  </head>
  <body style="margin:0;padding:0;overflow:hidden;background:#050505;">
    <LoadingScreen client:only="react" />
  </body>
</html>
