---
import "../styles/global.css";
---

<main class="cs">
  <div class="cs__bg-stack" id="csBgStack">
    {[
      "/media-studios/IMG_6932.jpeg",
      "/products/Highlights/rogue1-22.jpg",
      "/products/Highlights/rogue1-65.jpg",
      "/products/Highlights/rogue1-27.jpg",
      "/products/Highlights/rogue1-73.jpg",
    ].map((src, i) => (
      <div class:list={["cs__slide", i === 0 && "cs__slide--active"]}>
        <div class="cs__bg-blur" style={`background-image: url('${src}')`}></div>
        <div class="cs__bg-sharp" style={`background-image: url('${src}')`}></div>
      </div>
    ))}
  </div>
  <div class="cs__overlay"></div>

  <div class="cs__content">
    <img src="/brand/RS_wordlogo.PNG" alt="ROGU3" class="cs__logo" />
    <p class="cs__kicker">Site under development</p>
    <h1 class="cs__title">Coming Soon</h1>

    <form
      name="signup"
      method="POST"
      action="/thank-you"
      data-netlify="true"
      netlify-honeypot="bot-field"
      class="cs__signup"
      id="csSignupForm"
    >
      <input type="hidden" name="form-name" value="signup" />
      <p hidden>
        <label>Don't fill this out: <input name="bot-field" /></label>
      </p>
      <input
        type="email"
        name="email"
        placeholder="Your email"
        required
        class="cs__signup-input"
      />
      <button type="submit" class="cs__signup-btn">Notify me</button>
    </form>

    <div class="cs__links">
      <a href="https://www.instagram.com/rogu3studios?stkn=MWs3MndhbXl5cHB0dA%3D%3D" target="_blank" rel="noopener" class="cs__link">
        <svg class="cs__link-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <rect x="3" y="3" width="18" height="18" rx="5" />
          <circle cx="12" cy="12" r="4.2" />
          <circle cx="17.2" cy="6.8" r="1.1" fill="currentColor" stroke="none" />
        </svg>
        Instagram
      </a>
      <a href="https://www.youtube.com/results?search_query=rogu3+studios" target="_blank" rel="noopener" class="cs__link">
        <svg class="cs__link-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <rect x="2.5" y="5.5" width="19" height="13" rx="4" />
          <path d="M10.5 9.3 L15 12 L10.5 14.7 Z" fill="currentColor" stroke="none" />
        </svg>
        YouTube
      </a>
    </div>
  </div>
</main>

<script>
  const layers = document.querySelectorAll<HTMLDivElement>("#csBgStack .cs__slide");
  let current = 0;
  setInterval(() => {
    layers[current].classList.remove("cs__slide--active");
    current = (current + 1) % layers.length;
    layers[current].classList.add("cs__slide--active");
  }, 4500);

  const signupForm = document.querySelector<HTMLFormElement>("#csSignupForm");
  signupForm?.addEventListener("submit", () => {
    const submitBtn = signupForm.querySelector<HTMLButtonElement>(".cs__signup-btn");
    if (submitBtn) submitBtn.disabled = true;
  });
</script>

<style>
  html, body {
    height: 100%;
    background: #050505;
    color: #f5f5f7;
  }

  .cs {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .cs__bg-stack {
    position: absolute;
    inset: 0;
  }

  .cs__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 1.4s ease;
  }

  .cs__slide--active {
    opacity: 1;
  }

  .cs__bg-blur {
    position: absolute;
    inset: -20px;
    background-size: cover;
    background-position: center 22%;
    background-repeat: no-repeat;
    filter: blur(40px) brightness(0.7);
    transform: scale(1.15);
  }

  .cs__bg-sharp {
    position: absolute;
    top: 50%;
    left: 50%;
    width: min(95vh, 97vw, 900px);
    height: min(95vh, 97vw, 900px);
    transform: translate(-50%, -50%);
    background-size: cover;
    background-position: center 25%;
    background-repeat: no-repeat;
    border-radius: 0;
    box-shadow: 0 50px 140px rgba(0, 0, 0, 0.65);
  }

  .cs__overlay {
    position: absolute;
    inset: 0;
    background: rgba(5, 5, 5, 0.4);
  }

  .cs__content {
    position: absolute;
    top: 50%;
    left: 50%;
    width: min(95vh, 97vw, 900px);
    height: min(95vh, 97vw, 900px);
    transform: translate(-50%, -50%);
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    text-align: center;
    padding: clamp(24px, 4vw, 48px);
    border-radius: 0;
    background: linear-gradient(180deg, rgba(5, 5, 5, 0) 0%, rgba(5, 5, 5, 0.3) 40%, rgba(5, 5, 5, 0.9) 100%);
  }

  .cs__logo {
    height: clamp(160px, 22vw, 340px);
    width: auto;
    opacity: 0.95;
    margin-bottom: clamp(24px, 4vw, 40px);
  }

  .cs__kicker {
    margin: 0 0 14px;
    font-size: 11px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    opacity: 0.5;
  }

  .cs__title {
    margin: 0 0 22px;
    font-size: clamp(48px, 9vw, 128px);
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -0.02em;
  }

  .cs__signup {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin: 0 0 20px;
    max-width: 420px;
  }

  .cs__signup-input {
    flex: 1 1 220px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 999px;
    padding: 13px 18px;
    color: inherit;
    font-size: 14px;
    font-family: inherit;
    outline: none;
    transition: border-color 0.2s ease, background 0.2s ease;
  }

  .cs__signup-input::placeholder {
    color: rgba(245, 245, 247, 0.4);
  }

  .cs__signup-input:focus {
    border-color: rgba(255, 255, 255, 0.4);
    background: rgba(255, 255, 255, 0.09);
  }

  .cs__signup-btn {
    flex: 0 0 auto;
    padding: 13px 26px;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.18);
    background: #f5f5f7;
    color: #050505;
    font-size: 13px;
    font-family: inherit;
    font-weight: 700;
    letter-spacing: 0.04em;
    cursor: pointer;
    transition: transform 0.18s ease, opacity 0.2s ease;
  }

  .cs__signup-btn:hover {
    transform: translateY(-1px);
  }

  .cs__signup-btn:disabled {
    opacity: 0.6;
    cursor: default;
    transform: none;
  }

  .cs__links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px clamp(20px, 3vw, 32px);
  }

  .cs__link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #f5f5f7;
    text-decoration: none;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.04em;
    opacity: 0.75;
    border-bottom: 1px solid rgba(255, 255, 255, 0.25);
    padding-bottom: 2px;
    transition: opacity 0.2s ease;
  }

  .cs__link:hover {
    opacity: 1;
  }

  .cs__link-icon {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }
</style>
